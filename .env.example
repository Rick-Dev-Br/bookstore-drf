# Django
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=your-app-name.herokuapp.com,.herokuapp.com
CSRF_TRUSTED_ORIGINS=https://your-app-name.herokuapp.com

# Heroku Postgres provides DATABASE_URL automatically when the add-on is attached.
DATABASE_URL=postgres://user:password@host:5432/database

# GitHub Actions deploy secrets to configure in GitHub, not in Heroku:
# HEROKU_API_KEY=your-heroku-api-key
# HEROKU_APP_NAME=your-heroku-app-name
